---
import { Image } from "astro:assets";
import logo from "@/assets/logo-fisio-left-gold-white.png";
---

<footer class="bg-green-dark px-5 py-9 text-white md:px-8">
  <div class="mx-auto flex max-w-7xl flex-col gap-5 text-sm sm:flex-row sm:items-center sm:justify-between">
    <div class="h-10 flex">
      <Image src={logo} alt="" class="object-contain w-min"/>
    </div>

    <p class="text-white/55">© 2026 • Curso de Fisioterapia — UNAMA Santarém.</p>
  </div>
</footer>

