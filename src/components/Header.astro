---
import { Image } from "astro:assets";
import { Menu } from "@lucide/astro";
import logo from "@/assets/logo-fisio-left-gold-white.png";
---

<header class="absolute inset-x-0 top-0 z-40 border-b border-white/15">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between  px-3 md:px-8">
    <a href="#" aria-label="Fisioterapia UNAMA - Início" class="h-10 flex">
      <Image src={logo} alt="" class="object-contain w-min" />
    </a>

    <nav aria-label="Navegação principal" class="items-center gap-2 md:gap-7 text-sm font-semibold text-white/80 flex">
      <a class="transition hover:text-white" href="#products">Produtos</a>
      <a class="transition hover:text-white" href="#contact">Contato</a>
    </nav>
  </div>
</header>

