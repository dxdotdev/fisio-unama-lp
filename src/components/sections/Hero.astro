---
import { Image } from "astro:assets";
import { ArrowRight, Book, Calendar, Clock } from "@lucide/astro";
import art from "@/assets/art.png";

const whatsappMessage = encodeURIComponent(
	"Olá! Vim pelo site do Curso de Fisioterapia da UNAMA Santarém e gostaria de saber mais.",
);

const highlights = [
	{ Icon: Calendar, title: "Eventos", text: "Agenda acadêmica" },
	{ Icon: Book, title: "Palestras", text: "Conhecimento em rede" },
	{ Icon: Clock, title: "Programações", text: "Tudo em um só lugar" },
];
---

<section class="relative overflow-hidden bg-green-bg pt-20 md:py-20 text-white">
  <div class="absolute inset-0 opacity-[0.04] bg-[linear-gradient(var(--color-white)_1px,transparent_1px),linear-gradient(90deg,var(--color-white)_1px,transparent_1px)] bg-size-[48px_48px] mask-[linear-gradient(to_right,transparent,black)]" aria-hidden="true"></div>
  <div class="absolute -right-20 top-24 h-72 w-72 rounded-full bg-gold-bg/15 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid min-h-170 max-w-7xl items-center px-5 pt-20 md:pt-25 md:min-h-180 md:grid-cols-[1.05fr_.95fr] md:px-8 md:py-20">
    <div class="z-10 max-w-2xl">
      <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.25em] text-gold text-balance">
        <span class="h-px w-9 bg-gold"></span>
        Curso de Fisioterapia da UNAMA-Santarém
      </p>

      <h1 class="text-[2.5rem] font-black leading-[0.98] tracking-[-0.045em] sm:text-6xl md:text-6xl text-balance">
        Semana Acadêmica de
        <span class="text-[3rem] md:text-7xl block font-serif italic text-gold-light">fisioterapia</span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-7 text-white/72 sm:text-lg text-balance">
        Vem aí a Semana Acadêmica de Fisioterapia da UNAMA Santarém.
      </p>

      <p class="mt-7 max-w-xl text-base leading-7 text-white/72 sm:text-lg text-balance">
        Um momento de muito conhecimento, troca de experiência, aprendizado e valorização da nossa profissão.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://doity.com.br/semanafisio"
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-gold px-6 font-extrabold text-ink transition hover:bg-gold-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Faça a sua Inscrição<ArrowRight />
        </a>

        <a href="#products" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/30 px-6 font-bold transition hover:bg-white/10">
          Ver produtos
        </a>
      </div>
    </div>

    <div class="w-full aspect-square">
      <div aria-hidden="true" class="size-full grid place-items-center p-10">
        <div class="size-full rounded-full border border-gold/35 aspect-square grid place-items-center">
          <div class="size-4/5 rounded-full bg-linear-to-b from-green-light to-green-dark aspect-square grid place-items-center">
            <Image src={art} alt="" class="absolute w-100 drop-shadow-2xl md:w-150" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- <div class="relative border-t border-white/15 bg-green-dark/50"> -->
    <!-- <div class="mx-auto grid max-w-7xl grid-cols-3 divide-x divide-white/15 px-5 md:px-8"> -->
