        <!-- <div class="flex flex-col items-center gap-2 px-2 py-6 text-center sm:flex-row sm:justify-center sm:px-6 sm:text-left"> -->
          <!-- <Icon class="h-5 w-5 shrink-0 text-gold" /> -->

          <!-- <div> -->
            <!-- <strong class="block text-xs sm:text-sm">{title}</strong> -->
            <!-- <span class="hidden text-xs text-white/55 sm:block">{text}</span> -->
          <!-- </div> -->
        <!-- </div> -->
      <!-- ))} -->
    <!-- </div> -->
  <!-- </div> -->
</section>

